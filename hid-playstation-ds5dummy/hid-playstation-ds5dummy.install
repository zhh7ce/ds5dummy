# DS5Dummy hid-playstation DKMS fork — pacman install hooks

DKMS_NAME="hid-playstation-ds5dummy"
DKMS_VERSION="0.1.0"

_build_dkms() {
    if ! command -v dkms >/dev/null 2>&1; then
        echo ":: dkms is not installed; install it and rerun this hook."
        return 1
    fi

    dkms remove -m "$DKMS_NAME" -v "$DKMS_VERSION" --all >/dev/null 2>&1 || true
    dkms add -m "$DKMS_NAME" -v "$DKMS_VERSION" >/dev/null 2>&1 || true
    dkms build -m "$DKMS_NAME" -v "$DKMS_VERSION" || return 1
    dkms install -m "$DKMS_NAME" -v "$DKMS_VERSION" --force || return 1
    depmod -a
}

_reload_module() {
    # Best effort: the original module may be in use; a reboot will settle it.
    modprobe -r hid_playstation >/dev/null 2>&1 || true
    modprobe hid_playstation_ds5dummy >/dev/null 2>&1 || true
    command -v udevadm >/dev/null 2>&1 && udevadm trigger --subsystem-match=hidraw || true
}

post_install() {
    _build_dkms && _reload_module
    echo ":: hid-playstation-ds5dummy installed."
    echo "   In-tree hid_playstation is blacklisted."
    echo "   Bluetooth DualSense is exposed as hidraw-only with synthetic VID/PID 0x1998:0x1221."
}

post_upgrade() {
    post_install
}

post_remove() {
    dkms remove -m "$DKMS_NAME" -v "$DKMS_VERSION" --all >/dev/null 2>&1 || true
    depmod -a
    modprobe -r hid_playstation_ds5dummy >/dev/null 2>&1 || true
    modprobe hid_playstation >/dev/null 2>&1 || true
    echo ":: hid-playstation-ds5dummy removed."
}
