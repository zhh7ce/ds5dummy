# Maintainer: DS5Dummy Project
#
# Standalone DKMS fork of the in-tree hid-playstation driver.
# It does not use the ds5dummy CMake build at all.
#
# Build: cd hid-playstation-ds5dummy && makepkg -d
# Install: sudo pacman -U hid-playstation-ds5dummy-dkms-*.pkg.tar.zst

pkgname=hid-playstation-ds5dummy-dkms
# Repo root (this PKGBUILD lives one level down).
_srcdir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# 版本跟随 checkout，由下面的 pkgver() 现查。makepkg 会把结果写回本文件并把
# pkgrel 重置为 1，所以这里留占位值；改动提交后重新 makepkg 就是升级。
pkgver=0
pkgrel=1
pkgdesc="DS5Dummy hid-playstation DKMS fork: Bluetooth hidraw-only + synthetic VID/PID"
arch=('x86_64')
url="https://github.com/zhh7ce/ds5dummy"
license=('GPL-2.0-or-later')
depends=('dkms')
makedepends=('git')
optdepends=(
  'linux-cachyos-deckify-headers: build against the CachyOS Deckify kernel'
  'linux-headers: build against the stock Arch kernel'
)
install='hid-playstation-ds5dummy.install'
source=(
  'hid-playstation.c'
  'hid-ids.h'
  'Makefile'
  'dkms.conf'
  'ds5dummy-hid-playstation.conf'
  'ds5dummy-hid-playstation.modules-load.conf'
  'hid-playstation-ds5dummy.install'
)
b2sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

# <tag>.r<距 tag 的提交数>.g<短哈希>；还没打 tag 时 tag 段为 0、提交数取总数。
# pkgver 里不能有 "-"，所以把 git 输出里的分隔符换成点。
pkgver() {
  local ver
  if ver=$(git -C "$_srcdir" describe --tags --long --abbrev=7 2>/dev/null); then
    printf '%s\n' "$ver" | sed -E 's/^v//; s/-([0-9]+)-(g[0-9a-f]+)/.r\1.\2/'
  else
    printf '0.r%s.g%s\n' \
      "$(git -C "$_srcdir" rev-list --count HEAD)" \
      "$(git -C "$_srcdir" rev-parse --short=7 HEAD)"
  fi
}

package() {
  local dkmsdir="$pkgdir/usr/src/hid-playstation-ds5dummy-$pkgver"

  install -Dm644 hid-playstation.c "$dkmsdir/hid-playstation.c"
  install -Dm644 hid-ids.h "$dkmsdir/hid-ids.h"
  install -Dm644 Makefile "$dkmsdir/Makefile"
  install -Dm644 dkms.conf "$dkmsdir/dkms.conf"
  # DKMS 用 /usr/src/<name>-<version> 与 PACKAGE_VERSION 配对，版本号改成
  # git 派生值后必须把仓里的模板值一起替换掉。
  sed -i "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"$pkgver\"/" \
    "$dkmsdir/dkms.conf"

  install -Dm644 ds5dummy-hid-playstation.conf \
    "$pkgdir/usr/lib/modprobe.d/ds5dummy-hid-playstation.conf"
  install -Dm644 ds5dummy-hid-playstation.modules-load.conf \
    "$pkgdir/usr/lib/modules-load.d/ds5dummy-hid-playstation.conf"
}
