# CMake build outputs
build*/
**/build*/
compile_commands.json

# Packaging artifacts
pkg/src/
pkg/pkg/
*.pkg.tar.zst

# 构建模块时把上游驱动源码取回 kmod/ 里就地编译；目录里只有这三份进仓库
/kmod/*
!/kmod/README.md
!/kmod/Makefile
!/kmod/ds5dummy.patch

# IDE
.idea/
.vscode/
*.swp

# docs/ 下只有发布说明进 git；Doxygen 输出、演示文稿与本地草稿都不进
/docs/*
!/docs/releases/

# SDD 执行工作区（ledger/brief/report/review 包）
.superpowers/

/pkg/**/pkg/
/pkg/**/src/

# Python 字节码（tools/ 下的页面服务与单测）
__pycache__/
