# CMake build outputs
build*/
**/build*/
compile_commands.json

# Packaging artifacts
pkg/src/
pkg/pkg/
*.pkg.tar.zst

# 构建模块时把上游驱动源码取回 kmod/ 里就地编译；目录里只有这三份进仓库
/kmod/*
!/kmod/README.md
!/kmod/Makefile
!/kmod/ds5dummy.patch

# IDE
.idea/
.vscode/
*.swp

# docs/ 下：发布说明等正式文档进 git；Doxygen 输出与演示文稿物料不进
docs/doxygen/
docs/pre/

# AI 生成的临时文件与设计文档（.agents/ 内的约定见 AGENTS.md），以及
# 本地工具的私有状态，都不进 git
.agents/
.workbuddy/
.Trash-*/
.trust/

# SDD 执行工作区（ledger/brief/report/review 包）
.superpowers/

/pkg/**/pkg/
/pkg/**/src/

# Python 字节码（tools/ 下的页面服务与单测）
__pycache__/
