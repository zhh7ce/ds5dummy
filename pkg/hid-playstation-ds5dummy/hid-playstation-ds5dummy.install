# DS5Dummy hid-playstation DKMS fork — pacman install hooks
#
# The package version is derived from git, so it is never hardcoded here:
# pacman passes the full package version (<pkgver>-<pkgrel>) as $1 to every
# hook ($2 is the replaced version on upgrade).

DKMS_NAME="hid-playstation-ds5dummy"

# DKMS 认的版本是 dkms.conf 的 PACKAGE_VERSION，也就是 /usr/src 源码目录名里的
# pkgver；pacman 给的是 <pkgver>-<pkgrel>，这里去掉 epoch 与 pkgrel
# （本包 pkgver 不含 "-"，pkgrel 是最后一个 "-" 之后的那段）。
_dkms_version() {
    local version="${1##*:}"
    printf '%s\n' "${version%-*}"
}

_build_dkms() {
    local version="$1"

    if ! command -v dkms >/dev/null 2>&1; then
        echo ":: dkms is not installed; install it and rerun this hook."
        return 1
    fi

    dkms remove -m "$DKMS_NAME" -v "$version" --all >/dev/null 2>&1 || true
    dkms add -m "$DKMS_NAME" -v "$version" >/dev/null 2>&1 || true
    dkms build -m "$DKMS_NAME" -v "$version" || return 1
    dkms install -m "$DKMS_NAME" -v "$version" --force || return 1
    depmod -a
}

_drop_dkms() {
    local version="$1"

    [ -n "$version" ] || return 0
    dkms remove -m "$DKMS_NAME" -v "$version" --all >/dev/null 2>&1 || true
    depmod -a
}

_reload_module() {
    # Best effort: the original module may be in use; a reboot will settle it.
    modprobe -r hid_playstation >/dev/null 2>&1 || true
    modprobe hid_playstation_ds5dummy >/dev/null 2>&1 || true
    command -v udevadm >/dev/null 2>&1 && udevadm trigger --subsystem-match=hidraw || true
}

post_install() {
    _build_dkms "$(_dkms_version "$1")" && _reload_module
    echo ":: hid-playstation-ds5dummy installed."
    echo "   In-tree hid_playstation is blacklisted."
    echo "   Bluetooth DualSense is exposed as hidraw-only with synthetic VID/PID 0x1998:0x1221 (Edge: 0x1998:0x1103)."
}

post_upgrade() {
    _drop_dkms "$(_dkms_version "$2")"
    _build_dkms "$(_dkms_version "$1")" && _reload_module
}

pre_remove() {
    _drop_dkms "$(_dkms_version "$1")"
}

post_remove() {
    modprobe -r hid_playstation_ds5dummy >/dev/null 2>&1 || true
    modprobe hid_playstation >/dev/null 2>&1 || true
    echo ":: hid-playstation-ds5dummy removed."
}
