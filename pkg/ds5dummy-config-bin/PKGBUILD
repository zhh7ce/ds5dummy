# Maintainer: DS5Dummy Project
#
# DS5Dummy 配置页面的预编译包：与 pkg/ds5dummy-config 是同一个页面，只是打包时
# 用便携参数（-DDS5DUMMY_PORTABLE=ON）编出 buttons_check，并把 yaml-cpp 随包。
# 源码构建那份链系统的 yaml-cpp 与动态 libstdc++，只能在装了对应库的机器上跑；
# 这份给装不了工具链/库的机器（SteamOS 的镜像剥掉了开发文件）。
#
# 包名提供 ds5dummy-config：两个后端包的 optdepends 只写这个名字，装哪一份都满足。
#
# 布局（与 pkg/ds5dummy-bin 同一条理由）：随包的 yaml-cpp 用构建机上的 SONAME
# （Arch 是 libyaml-cpp.so.0.9，SteamOS 只有 .so.0.8），而便携构建的 RPATH 是
# $ORIGIN/../lib。二进制放 /usr/bin 时 RPATH 落到 /usr/lib，找不到随包的那份，
# 所以校验器与 .so 装进工具自己的前缀 /usr/lib/ds5dummy-config 的 bin/ 与 lib/：
#   bin/buttons_check  lib/libyaml-cpp.so.*
# /usr/bin/buttons_check 是指向 bin/ 的符号链接（/proc/self/exe 会解析成真实路径，
# $ORIGIN 因此仍指向前缀的 lib/）。页面本身是 Python，PyYAML 仍是系统依赖；
# glibc 保持动态。
#
# 前缀刻意与后端包的 /usr/lib/ds5dummy 分开：两个包都随包一份 yaml-cpp，
# pacman 不允许两个包拥有同一个路径，各占一棵树就不存在谁覆盖谁的问题。
#
# Build: cd pkg/ds5dummy-config-bin && makepkg -d
# Install on Arch or SteamOS: sudo pacman -U ds5dummy-config-bin-*.pkg.tar.zst
# （SteamOS 装 unit 前要 steamos-readonly disable；A/B 镜像更新会清掉 /usr 与
#   /etc 里的文件，更新后重装一次本包即可。）

pkgname=ds5dummy-config-bin
# Project source lives two directories up from this PKGBUILD.
_srcdir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
pkgver=0
pkgrel=1
pkgdesc="Local web page for editing DS5Dummy plugin settings (prebuilt)"
arch=('x86_64')
url="https://github.com/zhh7ce/ds5dummy"
license=('GPL-3.0-or-later')
# 两个后端包的 optdepends 只写不带后缀的名字，装哪一份都满足。
provides=('ds5dummy-config')
conflicts=('ds5dummy-config')
replaces=('ds5dummy-config')
# yaml-cpp 不在这里：随包那份在 /usr/lib/ds5dummy-config/lib 下，与宿主自己的版本互不干扰。
depends=('python' 'python-yaml')
# binutils：便携构建要读 yaml-cpp 的 SONAME；base-devel 里已有，写出来是为了在
# 容器里显式成链。
makedepends=('cmake' 'pkgconf' 'yaml-cpp' 'git' 'binutils')
optdepends=(
  'ds5dummy-hidraw: the HIDRAW-backend bridge whose plugins this page configures'
  'ds5dummy-l2cap: the L2CAP-backend bridge whose plugins this page configures'
)

# <tag>.r<距 tag 的提交数>.g<短哈希>；还没打 tag 时 tag 段为 0、提交数取总数。
# 只认 v* 标签：driver.* 是驱动 release 的指针，不参与版本号。
# pkgver 里不能有 "-"，所以把 git 输出里的分隔符换成点。
# 不是 git 仓库（发行版 tarball、手动拷贝的目录）时保留文件里的 pkgver。
pkgver() {
  local ver
  if ! git -C "$_srcdir" rev-parse --git-dir >/dev/null 2>&1; then
    printf '%s\n' "$pkgver"
    return 0
  fi
  if ver=$(git -C "$_srcdir" describe --tags --long --abbrev=7 --match 'v*' 2>/dev/null); then
    printf '%s\n' "$ver" | sed -E 's/^v//; s/-([0-9]+)-(g[0-9a-f]+)/.r\1.\2/'
  else
    printf '0.r%s.g%s\n' \
      "$(git -C "$_srcdir" rev-list --count HEAD)" \
      "$(git -C "$_srcdir" rev-parse --short=7 HEAD)"
  fi
}

build() {
  # CONFIG_ONLY 只注册 buttons_check：页面本身是 Python，不需要数据面的
  # PipeWire/Opus/BlueZ 依赖。PORTABLE 让它静态链 libstdc++、把 yaml-cpp 按
  # SONAME 落到构建树的 config-lib/。
  cmake -B "$srcdir/build-config" -S "$_srcdir" \
    -DCMAKE_BUILD_TYPE=Release \
    -DDS5DUMMY_STRICT=ON \
    -DDS5DUMMY_DEBUG=OFF \
    -DDS5DUMMY_DEBUG_LOG=OFF \
    -DDS5DUMMY_CONFIG_ONLY=ON \
    -DDS5DUMMY_PORTABLE=ON \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build-config" --target buttons_check
}

package() {
  # 入口脚本与源码包共用仓库里的那一份（源码包按 /usr/lib/ds5dummy 布局写死
  # 了 exec 路径）；这一份的页面在工具自己的前缀里，只改装好的副本上这一行。
  install -Dm755 "$_srcdir/pkg/ds5dummy-config/ds5dummy-config" \
    "$pkgdir/usr/bin/ds5dummy-config"
  sed -i 's#/usr/lib/ds5dummy/buttons_web.py#/usr/lib/ds5dummy-config/buttons_web.py#' \
    "$pkgdir/usr/bin/ds5dummy-config"
  install -Dm755 "$_srcdir/tools/buttons_web.py" \
    "$pkgdir/usr/lib/ds5dummy-config/buttons_web.py"
  install -Dm644 "$_srcdir/tools/buttons_web.html" \
    "$pkgdir/usr/lib/ds5dummy-config/buttons_web.html"
  install -Dm644 "$_srcdir/tools/panels/core.js" \
    "$pkgdir/usr/lib/ds5dummy-config/panels/core.js"

  # 保存前由它做权威判定；没有它页面会拒绝写回。RPATH 是 $ORIGIN/../lib，
  # 所以二进制与随包的 .so 必须保持在 bin/ 与 lib/ 这两个兄弟目录里。
  install -Dm755 "$srcdir/build-config/buttons_check" \
    "$pkgdir/usr/lib/ds5dummy-config/bin/buttons_check"
  install -d "$pkgdir/usr/bin"
  ln -s ../lib/ds5dummy-config/bin/buttons_check "$pkgdir/usr/bin/buttons_check"
  install -d "$pkgdir/usr/lib/ds5dummy-config/lib"
  install -m644 "$srcdir/build-config/config-lib/"*.so.* \
    "$pkgdir/usr/lib/ds5dummy-config/lib/"

  install -Dm644 "$_srcdir/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_srcdir/NOTICE" \
    "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  # 分发随包的 yaml-cpp 就带上它的 MIT 文本（构建机上找得到才有）。
  if compgen -G "$srcdir/build-config/config-lib/yaml-cpp-LICENSE" >/dev/null; then
    install -Dm644 "$srcdir/build-config/config-lib/yaml-cpp-LICENSE" \
      "$pkgdir/usr/share/licenses/$pkgname/yaml-cpp/LICENSE"
  fi
}
