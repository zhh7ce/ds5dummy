# Maintainer: DS5Dummy Project
#
# DS5Dummy with the raw L2CAP backend.
# Build: cd pkg/ds5dummy_l2cap && makepkg -d
# Install: sudo pacman -U ds5dummy_l2cap-*.pkg.tar.zst

pkgname=ds5dummy_l2cap
# Project source lives two directories up from this PKGBUILD.
_srcdir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# 版本跟随 checkout，由下面的 pkgver() 现查。makepkg 会把结果写回本文件并把
# pkgrel 重置为 1，所以这里留占位值；改动提交后重新 makepkg 就是升级。
pkgver=0
pkgrel=1
pkgdesc="Bridge a BT DualSense to a virtual USB device (raw L2CAP backend)"
arch=('x86_64')
url="https://github.com/zhh7ce/ds5dummy"
license=('GPL-3.0-or-later')
provides=('ds5dummy')
conflicts=('ds5dummy' 'ds5dummy_hidraw')
replaces=('ds5dummy')
depends=('bluez' 'pipewire' 'fmt' 'opus' 'libsamplerate' 'yaml-cpp' 'systemd-libs')
makedepends=('cmake' 'pkgconf' 'boost' 'git')
optdepends=(
  'dummy_hcd: kernel module (CONFIG_USB_DUMMY_HCD=m)'
  'ds5dummy-config: local web page for editing the plugin settings'
)
backup=(
  'etc/modprobe.d/ds5dummy.conf'
  'etc/modules-load.d/ds5dummy.conf'
  'etc/ds5dummy/config.yaml'
)
install='ds5dummy.install'
source=(
  'ds5dummy.modprobe.conf'
  'ds5dummy.modules-load.conf'
  'ds5dummy.install'
  'ds5dummy.service'
)
b2sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

# <tag>.r<距 tag 的提交数>.g<短哈希>；还没打 tag 时 tag 段为 0、提交数取总数。
# pkgver 里不能有 "-"，所以把 git 输出里的分隔符换成点。
pkgver() {
  local ver
  if ver=$(git -C "$_srcdir" describe --tags --long --abbrev=7 2>/dev/null); then
    printf '%s\n' "$ver" | sed -E 's/^v//; s/-([0-9]+)-(g[0-9a-f]+)/.r\1.\2/'
  else
    printf '0.r%s.g%s\n' \
      "$(git -C "$_srcdir" rev-list --count HEAD)" \
      "$(git -C "$_srcdir" rev-parse --short=7 HEAD)"
  fi
}

build() {
  cmake -B "$srcdir/build-l2cap" -S "$_srcdir" \
    -DCMAKE_BUILD_TYPE=Release \
    -DBT_BACKEND=L2CAP \
    -DDS5DUMMY_STRICT=ON \
    -DDS5DUMMY_DEBUG=OFF \
    -DDS5DUMMY_DEBUG_LOG=OFF \
    -DDS5DUMMY_BUILD_TOOLS=OFF \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build-l2cap"
}

package() {
  install -Dm755 "$srcdir/build-l2cap/ds5dummyd" \
    "$pkgdir/usr/bin/ds5dummyd"
  # 随包插件与主程序分开编、分开装；worker 启动时扫这个目录自动装载。
  install -Dm755 "$srcdir/build-l2cap/idle.so" \
    "$pkgdir/usr/lib/ds5dummy/plugins/idle.so"
  install -Dm755 "$srcdir/build-l2cap/buttons.so" \
    "$pkgdir/usr/lib/ds5dummy/plugins/buttons.so"
  # 配置页面的面板与 `.so` 同目录；缺了它页面退回通用键值编辑器，不影响装载。
  install -Dm644 "$_srcdir/plugin/idle/idle.panel.js" \
    "$pkgdir/usr/lib/ds5dummy/plugins/idle.panel.js"
  install -Dm644 "$_srcdir/plugin/buttons/buttons.panel.js" \
    "$pkgdir/usr/lib/ds5dummy/plugins/buttons.panel.js"
  # 配置页面是单独的 ds5dummy-config 包：页面壳、入口脚本与保存前的 buttons_check
  # 都不在这里。插件面板仍随 .so 装，页面按插件目录发现它们。
  # buttons 插件自己的用法文档：YAML 怎么写、全部键名与取值语法都在那一份里，
  # 用户模板只给这一条链接，不复制内容。
  install -Dm644 "$_srcdir/plugin/buttons/README.md" \
    "$pkgdir/usr/share/doc/ds5dummy/buttons.md"

  install -Dm755 "$_srcdir/scripts/teardown.sh" \
    "$pkgdir/usr/lib/ds5dummy/teardown.sh"

  install -Dm644 "$srcdir/ds5dummy.modprobe.conf" \
    "$pkgdir/etc/modprobe.d/ds5dummy.conf"
  install -Dm644 "$srcdir/ds5dummy.modules-load.conf" \
    "$pkgdir/etc/modules-load.d/ds5dummy.conf"

  install -Dm644 "$srcdir/ds5dummy.service" \
    "$pkgdir/usr/lib/systemd/system/ds5dummy.service"
  install -Dm755 "$_srcdir/pkg/ds5dummy.sleep-hook" \
    "$pkgdir/usr/lib/systemd/system-sleep/ds5dummy"

  install -Dm644 "$_srcdir/pkg/ds5dummy.system.yaml" \
    "$pkgdir/etc/ds5dummy/config.yaml"
  install -Dm644 "$_srcdir/pkg/user-config.example.yaml" \
    "$pkgdir/usr/share/doc/ds5dummy/user-config.example.yaml"

  install -Dm644 "$_srcdir/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_srcdir/NOTICE" \
    "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
